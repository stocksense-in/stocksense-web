{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3000", "--hostname", "127.0.0.1"],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "stocksense.api.app:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    }
  ]
}
