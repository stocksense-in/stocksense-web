# Copy to backend/.env and fill in. Never commit the real file.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# The service_role key. Server-side only: it bypasses row-level security.
# Do NOT prefix it with NEXT_PUBLIC_ — that would ship it to every browser.
SUPABASE_SERVICE_KEY=

# Upstox developer app (https://account.upstox.com/developer/apps) — only needed for
# `prices --source upstox` and `realtime`.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/callback
