# Copy to backend/.env and fill in. Never commit the real file.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# service_role key — the pipeline writes with it. Server-side only: it bypasses
# row-level security. Do NOT prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=
# anon (public) key — the API reads with it, so the API host can never write data.
SUPABASE_ANON_KEY=

# Browser origins allowed to call the API (comma-separated).
API_CORS_ORIGINS=http://localhost:3000

# Upstox developer app (https://account.upstox.com/developer/apps) — only needed for
# `prices --source upstox` and `realtime`.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/callback
